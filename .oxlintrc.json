{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "curly": ["error", "all"]
  },
  "settings": {
    "react": { "version": "18" }
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/data/**",
    "**/backups/**",
    "apps/backend/src/db/migrations/**"
  ],
  "overrides": [
    {
      "files": ["apps/backend/**"],
      "env": { "node": true }
    },
    {
      "files": ["apps/frontend/**"],
      "plugins": ["typescript", "unicorn", "import", "react"],
      "env": { "browser": true }
    }
  ]
}
