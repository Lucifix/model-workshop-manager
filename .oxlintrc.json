{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "curly": ["error", "all"],
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css", "@fastify/secure-session"] }]
  },
  "settings": {
    "react": { "version": "19" }
  },
  "ignorePatterns": [
    "**/build/**",
    "**/.react-router/**",
    "**/data/**",
    "**/backups/**",
    "app/db/migrations/**"
  ],
  "overrides": [
    {
      "files": [
        "server/**",
        "server.js",
        "app/**/*.server.ts",
        "app/db/**",
        "app/providers/**",
        "app/scripts/**",
        "app/routes/api.*.ts",
        "drizzle.config.ts",
        "react-router.config.ts",
        "vite.config.ts"
      ],
      "env": { "node": true }
    },
    {
      "files": ["app/pages/**", "app/components/**", "app/root.tsx", "app/routes/ui.*.tsx"],
      "plugins": ["typescript", "unicorn", "import", "react"],
      "env": { "browser": true }
    }
  ]
}
