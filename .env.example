# Copy to .env and adjust as needed. docker-compose reads this automatically.

# --- Backend ---------------------------------------------------------------
NODE_ENV=production

# --- Optional external provider (see docs/DATA_SOURCES.md) -----------------
# Off by default. Generic barcode lookup, not hobby-specific — a convenience
# quick-fill only, never a required dependency.
UPCITEMDB_ENABLED=false

# --- Auth (required — the server refuses to start without all three) -------
# Single-user login. Pick your own values; these are not defaults, there are
# no defaults. Never commit real values — this file is a template only.
AUTH_USERNAME=changeme
AUTH_PASSWORD=changeme
# Any string works (it's hashed into a proper key internally), but treat it
# like a password: long, random, and unique to this deployment. Generate one
# with: openssl rand -base64 32
SESSION_SECRET=changeme
# Set to true only once this app is served over HTTPS (e.g. behind a reverse
# proxy with TLS) — otherwise the browser will refuse to send the session
# cookie at all and login will appear to silently fail.
SESSION_COOKIE_SECURE=false

# --- Compose-level ---------------------------------------------------------
# Port exposed on the host for the frontend/reverse-proxy container.
HOST_PORT=8080

# --- Storage -----------------------------------------------------------------
# Where the database and uploaded photos live on the host. Unset, this
# defaults to a Docker-managed named volume (`workshop-data`) — fine for most
# setups. Set it to an absolute host path (e.g. a NAS mount) to bind-mount
# that instead, the same way BACKUP_DIR works below. (Deliberately not named
# DATA_DIR — that name is used inside the container for a different, fixed
# path and reusing it here would silently hijack it if it's already set.)
# WORKSHOP_DATA_DIR=/mnt/nas/model-workshop-manager

# --- Backup ------------------------------------------------------------------
# Nightly at 03:00 the `backup` service tars the whole data directory
# (database + uploaded photos) into a timestamped .tar.gz here, briefly
# pausing the backend for a consistent snapshot. The backend itself also
# reads/writes this folder for the in-app Backups tab (manual backup, list,
# download, restore, delete) — both sources land in the same place. Point
# this at a real host path — ideally one already covered by whatever backs
# up your other apps (NAS mount, rsync/restic target, etc.) — not the
# default, which lands under Portainer's internal stack directory and is
# easy to lose track of.
BACKUP_DIR=/home/YOUR_USER/backups/model-workshop-manager
BACKUP_RETENTION_DAYS=14
