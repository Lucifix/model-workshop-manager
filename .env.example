# Copy to .env and adjust as needed. docker-compose reads this automatically.

# --- Backend ---------------------------------------------------------------
NODE_ENV=production

# --- Optional external provider (see docs/DATA_SOURCES.md) -----------------
# Off by default. Generic barcode lookup, not hobby-specific — a convenience
# quick-fill only, never a required dependency.
UPCITEMDB_ENABLED=false

# --- Auth (required — the server refuses to start without all three) -------
# Single-user login. Pick your own values; these are not defaults, there are
# no defaults. Never commit real values — this file is a template only.
AUTH_USERNAME=changeme
AUTH_PASSWORD=changeme
# Any string works (it's hashed into a proper key internally), but treat it
# like a password: long, random, and unique to this deployment. Generate one
# with: openssl rand -base64 32
SESSION_SECRET=changeme
# Set to true only once this app is served over HTTPS (e.g. behind a reverse
# proxy with TLS) — otherwise the browser will refuse to send the session
# cookie at all and login will appear to silently fail.
SESSION_COOKIE_SECURE=false

# Set this if a reverse proxy sits in front of the app. Without it every
# request appears to come from the proxy, so the login rate limiter gives all
# clients one shared 5/minute budget instead of one each — safe, but it locks
# people out. The value is the number of proxies in front of this app
# (TRUST_PROXY=1 for a single nginx/Caddy/Traefik), or a preset such as
# "loopback", or an explicit IP/CIDR list.
# TRUST_PROXY=true is rejected on purpose and the app won't start: it trusts a
# header the client writes, letting anyone hand the rate limiter a new
# identity per request and bypass it entirely.
# TRUST_PROXY=1

# --- Compose-level ---------------------------------------------------------
# Which host interface the app port is published on. Defaults to loopback —
# set to 0.0.0.0 to reach it from elsewhere on your LAN, or leave this alone
# and put a reverse proxy/VPN in front instead.
# BIND_ADDRESS=127.0.0.1
# Port exposed on the host for the app container.
HOST_PORT=8080
# Port the app listens on *inside* the container. Rarely worth changing —
# HOST_PORT above is the one you reach it on. Compose keeps the published
# mapping in step with this automatically.
# APP_PORT=3000

# The container runs unprivileged rather than as root. These default to the
# image's own `node` user (1000:1000), which owns the data and backup
# directories inside the image — so the default named-volume setup needs no
# change. Set them only if you bind-mount WORKSHOP_DATA_DIR or BACKUP_DIR to
# a host directory owned by a different user; find the right values with
# `stat -c '%u:%g' /your/path` and chown the directory to match.
# APP_UID=1000
# APP_GID=1000

# --- Storage -----------------------------------------------------------------
# Where the database and uploaded photos live on the host. Unset, this
# defaults to a Docker-managed named volume (`workshop-data`) — fine for most
# setups. Set it to an absolute host path (e.g. a NAS mount) to bind-mount
# that instead, the same way BACKUP_DIR works below. (Deliberately not named
# DATA_DIR — that name is used inside the container for a different, fixed
# path and reusing it here would silently hijack it if it's already set.)
# WORKSHOP_DATA_DIR=/mnt/nas/model-workshop-manager

# --- Backup ------------------------------------------------------------------
# Nightly at 03:00 the `backup` service (opt-in — see docker-compose.yml,
# start it with `docker compose --profile backup up -d`) tars the whole data
# directory (database + uploaded photos) into a timestamped .tar.gz here,
# briefly pausing the backend for a consistent snapshot. The backend itself also
# reads/writes this folder for the in-app Backups tab (manual backup, list,
# download, restore, delete) — both sources land in the same place. Point
# this at a real host path — ideally one already covered by whatever backs
# up your other apps (NAS mount, rsync/restic target, etc.) — not the
# default, which lands under Portainer's internal stack directory and is
# easy to lose track of.
BACKUP_DIR=/home/YOUR_USER/backups/model-workshop-manager
BACKUP_RETENTION_DAYS=14
